index f381029..b31eadb 100644
--- a/keyboards/nuphy/halo65_v2/ansi/side.c
+++ b/keyboards/nuphy/halo65_v2/ansi/side.c
@@ -1101,6 +1101,220 @@ void rgb_test_show(void)
 /**
  * @brief  side_led_show.
  */
+/* ---------------------------------------------------------------------------
+ * Host-driven Halo ring -- see halo_host_t in ansi.h.
+ * ------------------------------------------------------------------------ */
+halo_host_t halo_host = {.mode = HALO_HOST_RELEASE};
+
+/* Ring length comes from the board's own table -- 50 on the Halo65 V2 -- so the
+ * count is not a second thing to keep in sync. */
+#define HALO_HOST_LED_NUM ((uint8_t)(sizeof(side_led_index_tab) / sizeof(side_led_index_tab[0])))
+
+static uint32_t halo_host_timer = 0;
+static uint32_t halo_host_phase = 0;
+
+void halo_host_set(const halo_host_t *cfg)
+{
+    halo_host       = *cfg;
+    halo_host_phase = 0;   /* every change restarts the animation from frame 0 */
+    halo_host_timer = timer_read32();
+}
+
+/* Paints ring position i with the host colour dimmed to level (0-255).
+ * count_rgb_light() is applied twice so the animation envelope and the overall
+ * brightness compose the same way the firmware's own effects do. */
+static void halo_host_pixel(uint8_t i, uint8_t level)
+{
+    r_temp = halo_host.r;
+    g_temp = halo_host.g;
+    b_temp = halo_host.b;
+    count_rgb_light(level);
+    count_rgb_light(halo_host.bright);
+    rgb_matrix_set_color(side_led_index_tab[i], r_temp, g_temp, b_temp);
+}
+
+static void halo_host_show(void)
+{
+    halo_host_phase += timer_elapsed32(halo_host_timer);
+    halo_host_timer = timer_read32();
+
+    const uint8_t  speed    = halo_host.speed ? halo_host.speed : 1;
+    const uint32_t step_ms  = 4 + (255 - speed) / 3;              /* per ring position */
+    const uint32_t cycle_ms = 240 + (uint32_t)(255 - speed) * 14; /* per full cycle */
+
+    switch (halo_host.mode) {
+        case HALO_HOST_SOLID:
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, 255);
+            break;
+
+        case HALO_HOST_PULSE: {
+            /* Reuses the firmware's own breathe curve so it feels native. */
+            uint8_t phase = (halo_host_phase % cycle_ms) * BREATHE_TAB_LEN / cycle_ms;
+            uint8_t level = breathe_data_tab[phase];
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, level);
+            break;
+        }
+
+        case HALO_HOST_COMET: {
+            uint8_t tail = halo_host.param ? halo_host.param : 12;
+            if (tail > HALO_HOST_LED_NUM) tail = HALO_HOST_LED_NUM;
+            uint8_t head = (halo_host_phase / step_ms) % HALO_HOST_LED_NUM;
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) {
+                uint8_t behind = (uint8_t)((head + HALO_HOST_LED_NUM - i) % HALO_HOST_LED_NUM);
+                uint8_t level  = behind < tail ? (uint8_t)(255 - behind * 255 / tail) : 0;
+                halo_host_pixel(i, level);
+            }
+            break;
+        }
+
+        case HALO_HOST_STROBE: {
+            uint8_t  duty   = halo_host.param ? halo_host.param : 50;
+            uint32_t period = cycle_ms / 3;   /* an alert should read as fast */
+            if (period == 0) period = 1;
+            bool on = (halo_host_phase % period) < (period * duty / 100);
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, on ? 255 : 0);
+            break;
+        }
+
+        case HALO_HOST_FILL: {
+            /* Sweeps around once, then holds the whole ring lit. */
+            uint32_t filled = halo_host_phase / step_ms;
+            if (filled > HALO_HOST_LED_NUM) filled = HALO_HOST_LED_NUM;
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, i < filled ? 255 : 0);
+            break;
+        }
+
+        default:
+            break;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Wireless status link -- hardware side of halo_link.c.
+ *
+ * The decoder hands over a state id; this maps it through the per-state slots
+ * kept in user_config (written over VIA when wired, updated field-by-field by
+ * config frames when wireless) onto the same primitives the USB path drives.
+ * ------------------------------------------------------------------------ */
+
+/* Compiled fallback, used until the daemon's first sync. Mirrors the
+ * DEFAULT_SETTINGS table in claude_halo65_daemon.py. */
+static const halo_link_slot_t halo_slot_defaults[HALO_LINK_STATE_COUNT] = {
+    [HALO_LINK_IDLE]       = {.ring_mode = HALO_HOST_RELEASE},
+    [HALO_LINK_RUNNING]    = {HALO_HOST_COMET,  0x00, 0xA8, 0xFF, 200, 12, 255, 5, 110, 1, 0, 0, 0, 60},
+    [HALO_LINK_PERMISSION] = {HALO_HOST_PULSE,  0xFF, 0xB0, 0x00, 215, 0,  255, 5, 230, 1, 0, 0, 0, 75},
+    [HALO_LINK_FAILURE]    = {HALO_HOST_STROBE, 0xFF, 0x20, 0x20, 230, 50, 255, 1, 128, 1, 0, 0, 0, 75},
+    [HALO_LINK_COMPLETED]  = {HALO_HOST_FILL,   0x00, 0xE0, 0x60, 215, 0,  255, 1, 128, 1, 0, 0, 0, 60},
+    [HALO_LINK_VOICE]      = {HALO_HOST_SOLID,  0xA8, 0x55, 0xF7, 128, 0,  255, 1, 128, 1, 0, 0, 0, 75},
+};
+
+static bool halo_link_mx_override = false;
+
+void halo_link_slots_default(void)
+{
+    memcpy(user_config.halo_slots, halo_slot_defaults, sizeof(halo_slot_defaults));
+    user_config.halo_slot_magic = HALO_LINK_SLOT_MAGIC;
+}
+
+/* Integer RGB -> QMK hue/sat, matching the daemon's hex_to_hsv to within one
+ * step. Only the follow-colour path needs it. */
+static void halo_link_rgb_to_hs(uint8_t r, uint8_t g, uint8_t b, uint8_t *h_out, uint8_t *s_out)
+{
+    uint8_t hi = r > g ? (r > b ? r : b) : (g > b ? g : b);
+    uint8_t lo = r < g ? (r < b ? r : b) : (g < b ? g : b);
+    uint8_t d  = (uint8_t)(hi - lo);
+    if (d == 0 || hi == 0) {
+        *h_out = 0;
+        *s_out = 0;
+        return;
+    }
+    *s_out = (uint8_t)(((uint16_t)d * 255) / hi);
+    int32_t h; /* hue on a 0..1535 wheel: 256 units per sextant */
+    if (hi == r)      h = ((int32_t)g - b) * 256 / d;
+    else if (hi == g) h = 512 + ((int32_t)b - r) * 256 / d;
+    else              h = 1024 + ((int32_t)r - g) * 256 / d;
+    if (h < 0) h += 1536;
+    *h_out = (uint8_t)(h * 256 / 1536);
+}
+
+void halo_link_render(uint8_t state)
+{
+    if (state >= HALO_LINK_STATE_COUNT) return;
+    const halo_link_slot_t *s = &user_config.halo_slots[state];
+
+    halo_host_t cfg = {
+        .mode   = s->ring_mode < HALO_HOST_MODE_COUNT ? s->ring_mode : HALO_HOST_RELEASE,
+        .r      = s->ring_r,
+        .g      = s->ring_g,
+        .b      = s->ring_b,
+        .speed  = s->ring_speed,
+        .param  = s->ring_param,
+        .bright = s->ring_bright,
+    };
+    halo_host_set(&cfg);
+
+    /* effect 0 means "leave the typing matrix alone"; an out-of-range value
+     * from a stale EEPROM is treated the same way rather than asserted on. */
+    if (s->mx_effect == 0 || s->mx_effect >= RGB_MATRIX_EFFECT_MAX) {
+        if (halo_link_mx_override) {
+            halo_link_mx_override = false;
+            rgb_matrix_reload_from_eeprom();
+        }
+        return;
+    }
+    uint8_t h, sat, v;
+    if (s->mx_flags & 0x01) {
+        halo_link_rgb_to_hs(s->ring_r, s->ring_g, s->ring_b, &h, &sat);
+        uint8_t hi    = s->ring_r > s->ring_g ? (s->ring_r > s->ring_b ? s->ring_r : s->ring_b)
+                                              : (s->ring_g > s->ring_b ? s->ring_g : s->ring_b);
+        uint8_t scale = s->mx_scale > 100 ? 100 : s->mx_scale;
+        v             = (uint8_t)(((uint16_t)hi * scale) / 100);
+    } else {
+        h   = s->mx_h;
+        sat = s->mx_s;
+        v   = s->mx_v;
+    }
+    halo_link_mx_override = true;
+    rgb_matrix_mode_noeeprom(s->mx_effect);
+    rgb_matrix_sethsv_noeeprom(h, sat, v);
+    rgb_matrix_set_speed_noeeprom(s->mx_speed);
+}
+
+void halo_link_store(uint8_t state, uint8_t field, const uint8_t *p)
+{
+    if (state >= HALO_LINK_STATE_COUNT) return;
+    halo_link_slot_t *s      = &user_config.halo_slots[state];
+    halo_link_slot_t  before = *s;
+    switch (field) {
+        case HALO_LINK_FIELD_RING_COLOR:
+            s->ring_r = p[0];
+            s->ring_g = p[1];
+            s->ring_b = p[2];
+            break;
+        case HALO_LINK_FIELD_RING_PARAMS:
+            s->ring_mode   = p[0];
+            s->ring_speed  = p[1];
+            s->ring_param  = p[2];
+            s->ring_bright = p[3];
+            break;
+        case HALO_LINK_FIELD_MATRIX:
+            s->mx_effect = p[0];
+            s->mx_speed  = p[1];
+            s->mx_flags  = p[2];
+            s->mx_h      = p[3];
+            s->mx_s      = p[4];
+            s->mx_v      = p[5];
+            s->mx_scale  = p[6];
+            break;
+        default:
+            return;
+    }
+    if (memcmp(&before, s, sizeof(*s)) != 0) {
+        eeconfig_update_user_datablock(&user_config);
+    }
+    if (halo_link_shown() == state) halo_link_render(state);
+}
