 extern user_config_t user_config;
+
+/* Host-driven Halo ring.
+ *
+ * The status-light daemon on the host owns the ring while it has something to
+ * report. The firmware only implements animation primitives -- colour, speed,
+ * tail length and brightness all arrive over VIA at runtime, so the look can be
+ * retuned without reflashing.
+ *
+ * HALO_HOST_RELEASE hands the ring straight back to the firmware's own effects,
+ * so whatever the user set with Fn+M survives untouched. */
+enum halo_host_mode {
+    HALO_HOST_RELEASE = 0,
+    HALO_HOST_SOLID,
+    HALO_HOST_PULSE,
+    HALO_HOST_COMET,
+    HALO_HOST_STROBE,
+    HALO_HOST_FILL,
+    HALO_HOST_MODE_COUNT,
+};
+
+typedef struct {
+    uint8_t mode;
+    uint8_t r, g, b;
+    uint8_t speed;   /* 1-255, larger is faster */
+    uint8_t param;   /* comet tail length, or strobe duty cycle in percent */
+    uint8_t bright;  /* 0-255 */
+} halo_host_t;
+
+extern halo_host_t halo_host;
+void halo_host_set(const halo_host_t *cfg);
 #define f_dev_sleep_enable  user_config.ee_dev_config.bit0
