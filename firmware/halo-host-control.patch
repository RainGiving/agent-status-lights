diff --git a/keyboards/nuphy/halo65_v2/ansi/halo_link.c b/keyboards/nuphy/halo65_v2/ansi/halo_link.c
new file mode 100644
index 0000000..b5d56ef
--- /dev/null
+++ b/keyboards/nuphy/halo65_v2/ansi/halo_link.c
@@ -0,0 +1,265 @@
+// Copyright 2026 agent-status-lights
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Decoder for the wireless status link -- protocol only, no hardware access,
+ * so the whole state machine can be compiled and exercised on the host.
+ * See halo_link.h for the wire format. */
+#include "halo_link.h"
+#include <string.h>
+
+#define FRAME_MAX_PAYLOAD 7
+#define FRAME_MAX_BYTES   (1 + FRAME_MAX_PAYLOAD + 1)
+
+static struct {
+    bool     started;
+    uint8_t  raw;        /* last raw LED byte, caps bit included */
+    uint8_t  sym;        /* last accepted 2-bit data symbol */
+    uint32_t edge_at;    /* last accepted wire transition */
+    uint32_t wipe_until; /* ignore 00 until then (OS rewrote the report) */
+    uint8_t  shown;
+    bool     esc;        /* escape prefix seen, operand outstanding */
+    uint32_t esc_at;
+    bool     zero_wait;  /* 00 seen; idle only once it outlives a wipe */
+    uint32_t zero_at;
+    bool     config;
+    uint32_t cfg_at;     /* last wire transition while in config mode */
+    uint8_t  tri_first;  /* first trit of a pending pair, 0xff = none */
+    uint8_t  frame[FRAME_MAX_BYTES];
+    uint8_t  nbits;
+    uint8_t  expect;     /* total frame bytes once the header is in, else 0 */
+    bool     bad;        /* current frame corrupt; wait for the inter-rep gap */
+    uint8_t  prev[FRAME_MAX_BYTES]; /* last CRC-clean frame, for the 2-match rule */
+    uint8_t  prev_len;
+} lk = {.shown = HALO_LINK_IDLE, .tri_first = 0xff};
+
+static bool before(uint32_t now, uint32_t deadline) {
+    return (int32_t)(now - deadline) < 0;
+}
+
+static uint8_t crc8(const uint8_t *p, uint8_t n) {
+    uint8_t crc = 0;
+    while (n--) {
+        crc ^= *p++;
+        for (uint8_t i = 0; i < 8; i++) {
+            crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0x07) : (uint8_t)(crc << 1);
+        }
+    }
+    return crc;
+}
+
+static uint8_t payload_len(uint8_t field) {
+    switch (field) {
+        case HALO_LINK_FIELD_RING_COLOR:  return 3;
+        case HALO_LINK_FIELD_RING_PARAMS: return 4;
+        case HALO_LINK_FIELD_MATRIX:      return 7;
+        default:                          return 0;
+    }
+}
+
+static void show(uint8_t state) {
+    if (state == lk.shown) return;
+    lk.shown = state;
+    halo_link_render(state);
+}
+
+static void frame_restart(void) {
+    lk.nbits     = 0;
+    lk.expect    = 0;
+    lk.bad       = false;
+    lk.tri_first = 0xff;
+}
+
+static void frame_complete(void) {
+    if (crc8(lk.frame, (uint8_t)(lk.expect - 1)) == lk.frame[lk.expect - 1]) {
+        if (lk.prev_len == lk.expect && memcmp(lk.prev, lk.frame, lk.expect) == 0) {
+            /* Second identical CRC-clean copy: only now is it believed. */
+            halo_link_store((uint8_t)(lk.frame[0] & 0x0f), (uint8_t)(lk.frame[0] >> 4),
+                            &lk.frame[1]);
+        } else {
+            memcpy(lk.prev, lk.frame, lk.expect);
+            lk.prev_len = lk.expect;
+        }
+    }
+    frame_restart();
+}
+
+static void config_push(uint8_t trit, uint32_t now) {
+    lk.cfg_at = now;
+    if (lk.bad) return;
+    if (lk.tri_first == 0xff) {
+        lk.tri_first = trit;
+        return;
+    }
+    uint8_t group = (uint8_t)(lk.tri_first * 3 + trit);
+    lk.tri_first  = 0xff;
+    if (group > 7) { /* trit pair value 8: not produced by the encoder */
+        lk.bad = true;
+        return;
+    }
+    for (int8_t i = 2; i >= 0; i--) {
+        uint8_t byte = (uint8_t)(lk.nbits >> 3);
+        if (byte >= FRAME_MAX_BYTES) {
+            lk.bad = true;
+            return;
+        }
+        if ((lk.nbits & 7) == 0) lk.frame[byte] = 0;
+        lk.frame[byte] |= (uint8_t)(((group >> i) & 1) << (7 - (lk.nbits & 7)));
+        lk.nbits++;
+        if (lk.nbits == 8) {
+            uint8_t plen = payload_len((uint8_t)(lk.frame[0] >> 4));
+            if (plen == 0 || (lk.frame[0] & 0x0f) >= HALO_LINK_STATE_COUNT) {
+                lk.bad = true;
+                return;
+            }
+            lk.expect = (uint8_t)(1 + plen + 1);
+        }
+        if (lk.expect && lk.nbits >= (uint8_t)(lk.expect * 8)) {
+            /* Anything left in this group is the sender's 3-bit padding. */
+            frame_complete();
+            return;
+        }
+    }
+}
+
+static void config_enter(uint32_t now) {
+    lk.config    = true;
+    lk.esc       = false;
+    lk.zero_wait = false;
+    lk.cfg_at    = now;
+    lk.prev_len  = 0;
+    frame_restart();
+}
+
+/* Leaving config mode re-latches whatever the sender parked on the wire: a
+ * direct symbol shows at once, 11 re-arms the escape so the resumed re-assert
+ * cycle lands on the right escaped state, and 00 goes through the usual idle
+ * confirmation. Without this a park value that happens to equal the next
+ * status symbol would never produce an edge and the display would stick. */
+static void config_exit(uint32_t now) {
+    lk.config = false;
+    frame_restart();
+    switch (lk.sym) {
+        case 3:  lk.esc = true; lk.esc_at = now; break;
+        case 1:  show(HALO_LINK_RUNNING); break;
+        case 2:  show(HALO_LINK_PERMISSION); break;
+        default:
+            if (lk.shown != HALO_LINK_IDLE) {
+                lk.zero_wait = true;
+                lk.zero_at   = now;
+            }
+            break;
+    }
+}
+
+uint8_t halo_link_shown(void) {
+    return lk.shown;
+}
+
+void halo_link_reset(void) {
+    /* Bookkeeping only. The display is deliberately left as it is: on a
+     * switch to USB the VIA path takes over from the same halo_host state,
+     * and blanking here would fight it. */
+    uint8_t shown = lk.shown;
+    memset(&lk, 0, sizeof(lk));
+    lk.shown     = shown;
+    lk.tri_first = 0xff;
+}
+
+void halo_link_sample(uint8_t leds, uint32_t now) {
+    uint8_t raw  = (uint8_t)(leds & 0x07);
+    uint8_t data = (uint8_t)((raw & 1) | ((raw >> 1) & 2));
+
+    if (!lk.started) {
+        /* The wire may already be mid-assertion when sampling begins (RF
+         * reconnect, decoder reset), so the first sample is decoded, not just
+         * latched -- a steady direct state would otherwise never render. */
+        lk.started = true;
+        lk.raw     = raw;
+        lk.sym     = data;
+        lk.edge_at = now;
+        if (data == 3) {
+            lk.esc    = true;
+            lk.esc_at = now;
+        } else if (data == 1) {
+            show(HALO_LINK_RUNNING);
+        } else if (data == 2) {
+            show(HALO_LINK_PERMISSION);
+        }
+        return;
+    }
+
+    bool caps_edge = ((raw ^ lk.raw) & 0x02) != 0;
+    lk.raw         = raw;
+
+    /* macOS rewrites the whole LED report when Caps Lock toggles, wiping both
+     * data bits to 00 until the sender's next refresh. The wipe arrives on a
+     * caps edge; ignore 00 for a window that outlives the refresh period. */
+    if (data == 0 && lk.sym != 0) {
+        if (caps_edge) lk.wipe_until = now + HALO_LINK_WIPE_GUARD_MS;
+        if (before(now, lk.wipe_until)) return;
+    }
+
+    if (data == lk.sym) { /* steady wire: timeouts only */
+        if (lk.config) {
+            if (!before(now, lk.cfg_at + HALO_LINK_EXIT_MS)) {
+                config_exit(now);
+            } else if (!before(now, lk.cfg_at + HALO_LINK_FRAME_GAP_MS)) {
+                frame_restart(); /* inter-rep gap: drop any partial frame */
+            }
+            return;
+        }
+        if (lk.esc && data == 3 && !before(now, lk.esc_at + HALO_LINK_ENTRY_MS)) {
+            config_enter(now);
+            return;
+        }
+        if (lk.zero_wait && data == 0 && !before(now, lk.zero_at + HALO_LINK_ZERO_CONFIRM_MS)) {
+            lk.zero_wait = false;
+            show(HALO_LINK_IDLE);
+            return;
+        }
+        /* An escaped state is kept alive by its re-assert cycle: an edge at
+         * least every 500 ms. A wire this quiet means the daemon moved to a
+         * direct state whose symbol equals what the cycle happened to end on
+         * -- voice ending into idle, failure into running -- which leaves no
+         * edge to decode. Re-latch the standing value like a config exit. */
+        if (lk.shown >= HALO_LINK_FAILURE && !lk.esc
+                && !before(now, lk.edge_at + HALO_LINK_RELATCH_MS)) {
+            lk.edge_at = now; /* one relatch per quiet period */
+            switch (data) {
+                case 3:  lk.esc = true; lk.esc_at = now; break;
+                case 1:  show(HALO_LINK_RUNNING); break;
+                case 2:  show(HALO_LINK_PERMISSION); break;
+                default: lk.zero_wait = true; lk.zero_at = now; break;
+            }
+        }
+        return;
+    }
+
+    uint8_t prev = lk.sym;
+    lk.sym       = data;
+    lk.edge_at   = now;
+
+    if (lk.config) {
+        /* data != prev, so the trit is 0-2 by construction. */
+        config_push((uint8_t)((data - prev - 1) & 3), now);
+        return;
+    }
+
+    lk.zero_wait = false;
+    if (data == 3) {
+        lk.esc    = true;
+        lk.esc_at = now;
+        return;
+    }
+    if (lk.esc) {
+        lk.esc = false;
+        show(data == 1 ? HALO_LINK_FAILURE
+                       : data == 2 ? HALO_LINK_VOICE : HALO_LINK_COMPLETED);
+        return;
+    }
+    if (data == 0) {
+        lk.zero_wait = true;
+        lk.zero_at   = now;
+        return;
+    }
+    show(data == 1 ? HALO_LINK_RUNNING : HALO_LINK_PERMISSION);
+}
diff --git a/keyboards/nuphy/halo65_v2/ansi/halo_link.h b/keyboards/nuphy/halo65_v2/ansi/halo_link.h
new file mode 100644
index 0000000..5e7a762
--- /dev/null
+++ b/keyboards/nuphy/halo65_v2/ansi/halo_link.h
@@ -0,0 +1,93 @@
+// Copyright 2026 agent-status-lights
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Wireless status link.
+ *
+ * Over Bluetooth and 2.4G the host cannot reach VIA; the only byte it can push
+ * is the standard HID keyboard LED report, and NuPhy's RF module forwards its
+ * low three bits over CMD_RF_STS_SYSC. Caps Lock belongs to the OS, which
+ * rewrites the whole byte on every toggle, so the usable payload is NumLock
+ * (bit 0) and ScrollLock (bit 2): one 2-bit symbol per sample.
+ *
+ * Status symbols: 00 idle, 01 running, 10 permission. 11 is an escape prefix;
+ * the following symbol selects 00 completed, 01 failure, 10 voice. Escaped
+ * states are re-asserted as a repeating 11/operand cycle, direct states as a
+ * periodic rewrite of the same value, so a state survives the OS overwriting
+ * the report. Completed gets the 00 operand deliberately: 00 doubles as the
+ * idle code and as what an OS rewrite leaves behind, so the state whose
+ * cycle contains 00 phases must be the one where a worst-case misread into
+ * idle is harmless -- completed decays into idle anyway. Voice and failure
+ * cycles contain no 00 at all.
+ *
+ * Holding 11 for HALO_LINK_ENTRY_MS switches the decoder into config mode,
+ * where every wire transition carries one base-3 digit: the sender always
+ * moves the wire, next = (prev + 1 + trit) mod 4, which is what makes the
+ * stream self-clocking -- no shared timing is needed, only edges. Two trits
+ * form one 3-bit group (values 0-7; 8 marks a corrupt pair), groups form
+ * frames of [header, payload, crc8], and a frame is applied only after two
+ * CRC-clean receptions with identical bytes. See docs/PROTOCOL.md in
+ * agent-status-lights for the host side and the measured timings. */
+
+enum halo_link_state {
+    HALO_LINK_IDLE = 0,
+    HALO_LINK_RUNNING,
+    HALO_LINK_PERMISSION,
+    HALO_LINK_FAILURE,
+    HALO_LINK_COMPLETED,
+    HALO_LINK_VOICE,
+    HALO_LINK_STATE_COUNT,
+};
+
+/* Config-frame header: low nibble = state id, high nibble = field id. */
+enum halo_link_field {
+    HALO_LINK_FIELD_RING_COLOR = 0, /* payload: r g b */
+    HALO_LINK_FIELD_RING_PARAMS,    /* payload: mode speed param bright */
+    HALO_LINK_FIELD_MATRIX,         /* payload: effect speed flags h s v scale */
+};
+
+/* One state's complete look, kept in user_config so it persists in EEPROM.
+ * The USB path writes it in one VIA report (channel 0x10, value id 0x02);
+ * the wireless path updates single fields through config frames. */
+typedef struct {
+    uint8_t ring_mode;        /* halo_host_mode; RELEASE leaves the ring alone */
+    uint8_t ring_r, ring_g, ring_b;
+    uint8_t ring_speed;
+    uint8_t ring_param;
+    uint8_t ring_bright;
+    uint8_t mx_effect;        /* 0 = leave the typing matrix alone */
+    uint8_t mx_speed;
+    uint8_t mx_flags;         /* bit 0: colour follows ring_r/g/b */
+    uint8_t mx_h, mx_s, mx_v; /* explicit HSV when the follow bit is clear */
+    uint8_t mx_scale;         /* value ceiling in percent when following */
+} halo_link_slot_t;
+
+#define HALO_LINK_SLOT_BYTES 14
+_Static_assert(sizeof(halo_link_slot_t) == HALO_LINK_SLOT_BYTES,
+               "slot layout is wire format and EEPROM format at once");
+
+#define HALO_LINK_SLOT_MAGIC 0x5A
+
+/* Decoder thresholds, all in ms. The sender's timings sit above each one:
+ * refresh 100 < wipe guard 300; escape phases 250/500 < entry 800; operand-00
+ * phase 250 (+jitter) < zero confirm 450; inter-rep gap 450 > frame gap 300
+ * but < exit 700; park hold 900 > exit 700; re-assert edges every 250 <
+ * quiet relatch 700. */
+#define HALO_LINK_WIPE_GUARD_MS   300
+#define HALO_LINK_ZERO_CONFIRM_MS 450
+#define HALO_LINK_ENTRY_MS        800
+#define HALO_LINK_FRAME_GAP_MS    300
+#define HALO_LINK_EXIT_MS         700
+#define HALO_LINK_RELATCH_MS      700
+
+/* Feed one sampled LED byte (low 3 bits meaningful). `now` is timer_read32()
+ * at the sample, passed in so the decoder stays testable off-target. */
+void    halo_link_sample(uint8_t leds, uint32_t now);
+void    halo_link_reset(void);
+uint8_t halo_link_shown(void);
+
+/* Provided by side.c: everything that touches actual hardware or EEPROM. */
+extern void halo_link_render(uint8_t state);
+extern void halo_link_store(uint8_t state, uint8_t field, const uint8_t *payload);
