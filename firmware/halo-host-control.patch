@@ -791,3 +798,141 @@ void housekeeping_task_kb(void)
     Sleep_Handle();
 
 }
+
+#ifdef VIA_ENABLE
+#    include "via.h"
+
+/* Vendor channel for the Halo ring.
+ *
+ * QMK's own custom channels stop at 0x05 and this keyboard defines none of its
+ * own, so 0x10 cannot collide. A sweep of id_custom_get_value across all 256
+ * channels on stock firmware answered on 0x03 alone, which is what makes this
+ * safe to claim.
+ *
+ * One value id carries the whole animation so a change lands atomically -- a
+ * mode and its colour arriving in separate reports would show a frame of the
+ * new animation in the old colour. */
+enum {
+    id_halo_channel = 0x10,
+};
+
+enum {
+    id_halo_animation  = 0x01,
+    id_halo_state_slot = 0x02,
+};
+
+#    define HALO_PAYLOAD_LEN 7
+
+/* Slot writes land in RAM and are committed by id_custom_save, so the daemon
+ * can stream all six states and pay for one EEPROM update. */
+static bool halo_slots_dirty = false;
+
+static void halo_animation_command(uint8_t *command_id, uint8_t *value_data, uint8_t length) {
+    switch (*command_id) {
+        case id_custom_set_value: {
+            if (length < 3 + HALO_PAYLOAD_LEN || value_data[0] >= HALO_HOST_MODE_COUNT) {
+                *command_id = id_unhandled;
+                return;
+            }
+            halo_host_t cfg = {
+                .mode   = value_data[0],
+                .r      = value_data[1],
+                .g      = value_data[2],
+                .b      = value_data[3],
+                .speed  = value_data[4],
+                .param  = value_data[5],
+                .bright = value_data[6],
+            };
+            halo_host_set(&cfg);
+            break;
+        }
+
+        case id_custom_get_value: {
+            value_data[0] = halo_host.mode;
+            value_data[1] = halo_host.r;
+            value_data[2] = halo_host.g;
+            value_data[3] = halo_host.b;
+            value_data[4] = halo_host.speed;
+            value_data[5] = halo_host.param;
+            value_data[6] = halo_host.bright;
+            break;
+        }
+
+        case id_custom_save:
+            /* The live animation is a transient status display; persisting it
+             * would mean booting into whatever the last task's colour was.
+             * What save does commit is the state slots below. */
+            if (halo_slots_dirty) {
+                halo_slots_dirty = false;
+                eeconfig_update_user_datablock(&user_config);
+            }
+            break;
+
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+
+/* value_data = [ state, 14 slot bytes ] -- the wired fast path for what the
+ * wireless link can only trickle through config frames. */
+static void halo_slot_command(uint8_t *command_id, uint8_t *value_data, uint8_t length) {
+    if (length < 3 + 1 || value_data[0] >= HALO_LINK_STATE_COUNT) {
+        *command_id = id_unhandled;
+        return;
+    }
+    halo_link_slot_t *slot = &user_config.halo_slots[value_data[0]];
+
+    switch (*command_id) {
+        case id_custom_set_value:
+            if (length < 3 + 1 + HALO_LINK_SLOT_BYTES) {
+                *command_id = id_unhandled;
+                return;
+            }
+            if (memcmp(slot, &value_data[1], HALO_LINK_SLOT_BYTES) != 0) {
+                memcpy(slot, &value_data[1], HALO_LINK_SLOT_BYTES);
+                halo_slots_dirty = true;
+            }
+            break;
+
+        case id_custom_get_value:
+            memcpy(&value_data[1], slot, HALO_LINK_SLOT_BYTES);
+            break;
+
+        case id_custom_save:
+            if (halo_slots_dirty) {
+                halo_slots_dirty = false;
+                eeconfig_update_user_datablock(&user_config);
+            }
+            break;
+
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+
+void via_custom_value_command_kb(uint8_t *data, uint8_t length) {
+    // data = [ command_id, channel_id, value_id, value_data ]
+    uint8_t *command_id = &(data[0]);
+    uint8_t *channel_id = &(data[1]);
+    uint8_t *value_id   = &(data[2]);
+    uint8_t *value_data = &(data[3]);
+
+    if (*channel_id != id_halo_channel) {
+        *command_id = id_unhandled;
+        return;
+    }
+    switch (*value_id) {
+        case id_halo_animation:
+            halo_animation_command(command_id, value_data, length);
+            break;
+        case id_halo_state_slot:
+            halo_slot_command(command_id, value_data, length);
+            break;
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+#endif
