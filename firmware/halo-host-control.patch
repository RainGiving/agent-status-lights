diff --git a/keyboards/nuphy/halo65_v2/ansi/side.c b/keyboards/nuphy/halo65_v2/ansi/side.c
index f381029..38d6dd4 100644
--- a/keyboards/nuphy/halo65_v2/ansi/side.c
+++ b/keyboards/nuphy/halo65_v2/ansi/side.c
@@ -1101,6 +1101,94 @@ void rgb_test_show(void)
 /**
  * @brief  side_led_show.
  */
+/* ---------------------------------------------------------------------------
+ * Host-driven Halo ring -- see halo_host_t in ansi.h.
+ * ------------------------------------------------------------------------ */
+halo_host_t halo_host = {.mode = HALO_HOST_RELEASE};
+
+/* Ring length comes from the board's own table -- 50 on the Halo65 V2 -- so the
+ * count is not a second thing to keep in sync. */
+#define HALO_HOST_LED_NUM ((uint8_t)(sizeof(side_led_index_tab) / sizeof(side_led_index_tab[0])))
+
+static uint32_t halo_host_timer = 0;
+static uint32_t halo_host_phase = 0;
+
+void halo_host_set(const halo_host_t *cfg)
+{
+    halo_host       = *cfg;
+    halo_host_phase = 0;   /* every change restarts the animation from frame 0 */
+    halo_host_timer = timer_read32();
+}
+
+/* Paints ring position i with the host colour dimmed to level (0-255).
+ * count_rgb_light() is applied twice so the animation envelope and the overall
+ * brightness compose the same way the firmware's own effects do. */
+static void halo_host_pixel(uint8_t i, uint8_t level)
+{
+    r_temp = halo_host.r;
+    g_temp = halo_host.g;
+    b_temp = halo_host.b;
+    count_rgb_light(level);
+    count_rgb_light(halo_host.bright);
+    rgb_matrix_set_color(side_led_index_tab[i], r_temp, g_temp, b_temp);
+}
+
+static void halo_host_show(void)
+{
+    halo_host_phase += timer_elapsed32(halo_host_timer);
+    halo_host_timer = timer_read32();
+
+    const uint8_t  speed    = halo_host.speed ? halo_host.speed : 1;
+    const uint32_t step_ms  = 4 + (255 - speed) / 3;              /* per ring position */
+    const uint32_t cycle_ms = 240 + (uint32_t)(255 - speed) * 14; /* per full cycle */
+
+    switch (halo_host.mode) {
+        case HALO_HOST_SOLID:
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, 255);
+            break;
+
+        case HALO_HOST_PULSE: {
+            /* Reuses the firmware's own breathe curve so it feels native. */
+            uint8_t phase = (halo_host_phase % cycle_ms) * BREATHE_TAB_LEN / cycle_ms;
+            uint8_t level = breathe_data_tab[phase];
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, level);
+            break;
+        }
+
+        case HALO_HOST_COMET: {
+            uint8_t tail = halo_host.param ? halo_host.param : 12;
+            if (tail > HALO_HOST_LED_NUM) tail = HALO_HOST_LED_NUM;
+            uint8_t head = (halo_host_phase / step_ms) % HALO_HOST_LED_NUM;
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) {
+                uint8_t behind = (uint8_t)((head + HALO_HOST_LED_NUM - i) % HALO_HOST_LED_NUM);
+                uint8_t level  = behind < tail ? (uint8_t)(255 - behind * 255 / tail) : 0;
+                halo_host_pixel(i, level);
+            }
+            break;
+        }
+
+        case HALO_HOST_STROBE: {
+            uint8_t  duty   = halo_host.param ? halo_host.param : 50;
+            uint32_t period = cycle_ms / 3;   /* an alert should read as fast */
+            if (period == 0) period = 1;
+            bool on = (halo_host_phase % period) < (period * duty / 100);
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, on ? 255 : 0);
+            break;
+        }
+
+        case HALO_HOST_FILL: {
+            /* Sweeps around once, then holds the whole ring lit. */
+            uint32_t filled = halo_host_phase / step_ms;
+            if (filled > HALO_HOST_LED_NUM) filled = HALO_HOST_LED_NUM;
+            for (uint8_t i = 0; i < HALO_HOST_LED_NUM; i++) halo_host_pixel(i, i < filled ? 255 : 0);
+            break;
+        }
+
+        default:
+            break;
+    }
+}
+
 void m_side_led_show(void)
 {
     static bool flag_power_on         = 1;
@@ -1119,6 +1207,19 @@ void m_side_led_show(void)
        return;
     }
 
